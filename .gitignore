# Secrets and local credentials
*.env
.env
*.pem
*.key

# Runtime outputs
runs/
**/runs/
*.sqlite
*.sqlite-*
*.db
*.log
*.pid
*.logpath
*.jsonl
*.jsonl.zst
*.zst
